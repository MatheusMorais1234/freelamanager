# ============================================================
# Build de producao (npm run build)
# ------------------------------------------------------------
# Em producao o backend serve o frontend no mesmo endereco, com
# a API em /api. Nada aqui e segredo: tudo que comeca com VITE_
# vai parar no JavaScript que o navegador baixa.
# ============================================================

VITE_API_URL="/api"

# Conta de demonstracao exibida na tela de login.
# Criada no banco de producao com: cd backend && npm run seed:demo
VITE_DEMO_EMAIL="demo@freelamanager.com"
VITE_DEMO_PASSWORD="demo1234"
