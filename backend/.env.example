# ============================================================
# FreelaManager - MODELO de variaveis de ambiente
# ============================================================
# Este arquivo VAI para o Git. Ele contem apenas os NOMES das
# variaveis, nunca valores reais.
#
# Para usar:
#   1. copie este arquivo para ".env"   (cp .env.example .env)
#   2. preencha com os seus valores
#   3. o ".env" fica so na sua maquina (esta no .gitignore)
# ============================================================

# --- Banco de dados ---
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO?schema=public
DATABASE_URL="postgresql://usuario:senha@localhost:5432/freelamanager?schema=public"

# --- Autenticacao (JWT) ---
# Chave secreta usada para ASSINAR os tokens.
# Quem tiver essa chave consegue forjar login de qualquer usuario.
# Gere uma aleatoria e longa com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="troque-por-uma-chave-aleatoria-longa"

# Por quanto tempo o token continua valido apos o login.
JWT_EXPIRES_IN="7d"

# --- Servidor ---
# Porta em que a API vai escutar.
PORT=3000

# Origem do frontend autorizada a chamar esta API (regra de CORS).
# O Vite usa 5173 por padrao.
CORS_ORIGIN="http://localhost:5173"
