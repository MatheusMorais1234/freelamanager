// FreelaManager

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "esm"
}

// URL vem do .env (prisma.config.ts)
datasource db {
  provider = "postgresql"
}

enum ContractStatus {
  PENDING // aguardando aprovacao do cliente
  ACTIVE // em andamento
  COMPLETED // entregue e pago
  CANCELLED // cancelado
}

enum PaymentMethod {
  PIX
  TRANSFER // transferencia bancaria / TED
  BOLETO
  CARD // cartao de credito ou debito
  CASH // dinheiro
  OTHER
}

// PF ou PJ
enum ClientType {
  PERSON
  COMPANY
}

model User {
  id           String   @id @default(uuid())
  name         String   @db.VarChar(120)
  email        String   @unique @db.VarChar(180)
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  clients   Client[]
  contracts Contract[]
  payments  Payment[]

  @@map("users")
}

model Client {
  id     String     @id @default(uuid())
  userId String     @map("user_id")
  type   ClientType @default(PERSON)

  // name = nome ou razao social, trade = nome fantasia
  name    String  @db.VarChar(120)
  company String? @db.VarChar(120)

  // so digitos
  document String? @db.VarChar(14)

  stateRegistration String?   @map("state_registration") @db.VarChar(20)
  birthDate         DateTime? @map("birth_date") @db.Date

  email   String? @db.VarChar(180)
  phone   String? @db.VarChar(20)
  mobile  String? @db.VarChar(20)
  website String? @db.VarChar(180)

  zipCode    String? @map("zip_code") @db.VarChar(8)
  street     String? @db.VarChar(160)
  number     String? @db.VarChar(20)
  complement String? @db.VarChar(80)
  district   String? @db.VarChar(80)
  city       String? @db.VarChar(80)
  state      String? @db.VarChar(2)

  notes String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  contracts Contract[]

  // CPF/CNPJ unico por usuario
  @@unique([userId, document], name: "client_user_document")
  @@index([userId])
  @@map("clients")
}

model Contract {
  id          String         @id @default(uuid())
  clientId    String         @map("client_id")
  userId      String         @map("user_id")
  title       String         @db.VarChar(160)
  description String?
  amount      Decimal        @db.Decimal(12, 2)
  status      ContractStatus @default(PENDING)
  dueDate     DateTime?      @map("due_date") @db.Date

  createdAt DateTime @default(now()) @map("created_at")

  client   Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@index([userId])
  @@index([clientId])
  @@index([status])
  @@map("contracts")
}

model Payment {
  id         String @id @default(uuid())
  contractId String @map("contract_id")
  userId     String @map("user_id")

  // ex: "Entrada", "Parcela 2/3"
  description String? @db.VarChar(160)

  amount Decimal @db.Decimal(12, 2)

  dueDate DateTime @map("due_date") @db.Date

  // null = em aberto. Status e calculado a partir daqui.
  paidAt DateTime? @map("paid_at") @db.Date

  method PaymentMethod?

  notes String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([contractId])
  @@index([dueDate])
  @@map("payments")
}
